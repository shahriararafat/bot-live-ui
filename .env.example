# Upstash Redis REST credentials. The Vercel Upstash integration sets these.
# Leave both pairs empty for local dev: the app falls back to an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Accepted aliases (some Upstash / Vercel KV integrations use these names instead).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bearer token required by POST /api/status and POST /api/dashboard.
INGEST_TOKEN=

# Passcode for the office page and GET /api/office. Also signs the session cookie.
APP_PASSCODE=

# Used by scripts/report.sh and scripts/report-dashboard.sh, not by the Next.js server.
BOT_OFFICE_URL=http://localhost:3000
BOT_OFFICE_TOKEN=

# Optional env-file path for report.sh. Defaults to /workspace/bot-office/.env
BOT_OFFICE_ENV=
